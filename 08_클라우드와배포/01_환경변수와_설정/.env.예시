# ============================================================
# .env.예시 — 이 파일은 Git 에 올립니다
# ------------------------------------------------------------
# 진짜 값이 아니라 '무엇이 필요한지' 만 적습니다.
# 새로 온 사람이 이 파일을 복사해서 .env 를 만듭니다.
#
#   cp .env.예시 .env
# ============================================================

# 서버가 쓸 포트
PORT=3000

# 어떤 환경인가  development | production | test
NODE_ENV=development

# 데이터베이스 (02단원부터 씁니다)
DB_FILE=./data/설비.db

# CORS 로 허락할 출처. 쉼표로 여러 개
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# 업로드 용량 제한 (바이트)
MAX_UPLOAD_SIZE=5242880

# 관리자 증표 — ★ 진짜 값은 여기 적지 않습니다
ADMIN_KEY=여기에_진짜_값을_넣으세요
